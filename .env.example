# ---------------------------------------------------------------------------
# WildHer Adventures — environment variables
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# Sanity CMS — required for the site to read content and for /studio to load.
# Get these from https://sanity.io/manage after creating your project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-05-01

# Optional — only needed for draft/preview mode. Create at:
# https://sanity.io/manage -> Project -> API -> Tokens (Viewer/read role).
SANITY_API_READ_TOKEN=

# Used ONLY by the seed script (npm run seed:sanity). Editor role.
SANITY_API_WRITE_TOKEN=

# Calendly — the URL of the WildHer Calendly event used for "Rezerviraj razgovor".
# Public URL, safe to expose to the client.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/wildheradventures

# Public site URL used by sitemap.xml, OG metadata, and JSON-LD canonical links.
# Set to the deployed origin in production; localhost in dev is fine.
NEXT_PUBLIC_SITE_URL=https://wildheradventures.ba

